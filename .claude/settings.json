{
  "permissions": {
    "allow": [
      "Bash(cmake:*)", "Bash(ctest:*)", "Bash(ninja:*)", "Bash(make:*)", "Bash(pg_config:*)",
      "Bash(docker ps:*)", "Bash(docker inspect:*)", "Bash(docker logs:*)", "Bash(docker exec:*)", "Bash(docker cp:*)", "Bash(docker compose:*)",
      "Bash(scripts/dev-up.sh:*)", "Bash(scripts/verify.sh:*)", "Bash(scripts/build-in-docker.sh:*)", "Bash(scripts/agents-sync.sh:*)",
      "Bash(python3:*)", "Bash(pytest:*)", "Bash(ruff:*)", "Bash(mypy:*)",
      "Bash(clang-format:*)", "Bash(clang-tidy:*)", "Bash(cppcheck:*)", "Bash(shellcheck:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)", "Bash(git branch:*)",
      "Bash(openssl version:*)", "Bash(grep:*)", "Bash(rg:*)", "Bash(find:*)", "Bash(wc:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)",
      "Read(./**/*.pem)", "Read(./**/*.key)", "Read(./.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh" } ]
      }
    ]
  }
}
